      {
        "from": "REDUCED",
        "to": "PAUSED",
        "when": "S7.health_score < 60 or S6.level >= 2"
      },
      {
        "from": "PAUSED",
        "to": "ON",
        "when": "S7.health_score >= 80 and S6.level == 0 and cooldown_complete == true"
      },
      {
        "from": "*",
        "to": "OFF",
        "when": "S6.level == 3 and event_type in hard_level_3_system_events"
      }
    ]
