      "system_anomaly_manual_resume": {
        "events": [
          "position_mismatch",
          "unexpected_leverage",
          "risk_engine_unavailable",
          "order_reconciliation_failure",
          "exchange_connectivity_lost"
        ],
        "auto_resume": false,
        "requirements": [
          "exchange_connected == true",
          "market_data_stale_ms < 250",
          "sequence_valid == true",
          "positions_reconciled == true",
          "orders_reconciled == true",
          "risk_engine_healthy == true",
          "manual_ack == true",
          "manual_ack must originate from manual_resume_control endpoint"
        ],
        "manual_resume_control": {
          "enabled": true,
          "endpoint": "/api/v1/system/resume",
          "method": "POST",
          "transport": "HTTPS",
          "authentication_required": true,
          "authorization": {
            "required_role": "risk_admin",
            "multi_factor_auth_recommended": true
          },
          "idempotency": {
            "required": true,
            "header": "Idempotency-Key"
