{
  "meta": {
    "name": "AI Multi-Strategy Trading System",
    "version": "4.1",
    "status": "research_paper_trading",
    "market_focus": "crypto_perpetuals",
    "timezone": "UTC+8",
    "config_type": "deterministic_event_driven_execution_schema",
    "live_trading_allowed": false,
    "design_principles": [
      "risk_first",
      "deterministic_core_logic",
      "no_llm_interpretation_in_core_execution_path",
      "bounded_offline_parameter_adaptation_only",
      "all_state_transitions_are_auditable",
      "all_risk_allocations_are_hard_capped",
      "signals_have_explicit_lifecycle_and_expiry",
      "execution_must_revalidate_signal_before_order_creation",
      "edge_estimation_must_have_defined_runtime_data_source",
      "manual_resume_requires_authenticated_audited_control_path"
    ]
  },
  "engine_contract": {
    "expression_language": {
      "supported_operators": [
        "gt",
        "gte",
        "lt",
        "lte",
        "eq",
        "neq",
        "and",
        "or",
        "not",
        "add",
        "sub",
        "mul",
        "div",
        "abs",
        "min",
        "max",
        "clip",
        "in",
        "not_in"
      ],
      "missing_value_policy": "fail_closed",
      "boolean_rule_policy": "all_required_conditions_must_be_explicit"
    },
    "decision_order": [
      "S6_safety_gate",
      "data_quality_gate",
      "position_order_reconciliation",
      "global_portfolio_risk_gate",
      "S7_strategy_health_gate",
      "S3_market_regime",
      "S5_risk_budget_allocation",
      "S1_S2_signal_generation",
      "S4_execution_timing",
      "cost_slippage_gate",
      "final_order_creation"
    ],
    "runtime_objects": {
      "TradeIntent": {
        "description": "Directional opportunity emitted by S1/S2 and consumed by S4/Router.",
        "required_fields": [
          "intent_id",
          "strategy_id",
          "symbol",
          "direction",
          "created_at",
          "expires_at",
          "reference_price",
          "reference_atr",
          "signal_snapshot",
          "status"
        ]
      },
      "OrderIntent": {
        "description": "Executable order candidate created only after TradeIntent passes lifecycle, revalidation, safety, cost and risk gates.",
        "required_fields": [
          "order_intent_id",
          "trade_intent_id",
          "symbol",
          "direction",
          "quantity",
          "order_type",
          "created_at",
          "risk_snapshot"
        ]
      }
    }
  },
  "data_schema": {
    "bar_fields": [
      "timestamp",
      "open",
      "high",
      "low",
      "close",
      "volume"
    ],
    "derivatives_fields": [
      "funding_rate",
      "open_interest",
      "basis"
    ],
    "microstructure_fields": [
      "best_bid",
      "best_ask",
      "bid_depth",
      "ask_depth",
      "aggressive_buy_volume",
      "aggressive_sell_volume"
    ],
    "portfolio_fields": [
      "equity",
      "cash",
      "position_qty",
      "position_side",
      "position_avg_price",
      "open_order_qty",
      "realized_pnl_day",
      "equity_high_watermark"
    ],
    "quality_requirements": {
      "bars_monotonic_timestamp": true,
      "duplicate_bar_allowed": false,
      "max_bar_gap_multiplier": 2,
      "position_reconciliation_required": true,
      "order_reconciliation_required": true
    }
  },
  "feature_definitions": {
    "atr14": {
      "type": "indicator",
      "formula": "ATR(high, low, close, 14)"
    },
    "ema20": {
      "type": "indicator",
      "formula": "EMA(close, 20)"
    },
    "ema50": {
      "type": "indicator",
      "formula": "EMA(close, 50)"
    },
    "ema200": {
      "type": "indicator",
      "formula": "EMA(close, 200)"
    },
    "adx14": {
      "type": "indicator",
      "formula": "ADX(high, low, close, 14)"
    },
    "rsi14": {
      "type": "indicator",
      "formula": "RSI(close, 14)"
    },
    "trend_separation": {
      "type": "derived",
      "formula": "(ema20 - ema50) / max(atr14, 1e-12)"
    },
    "trend_slope_6": {
      "type": "derived",
      "formula": "(ema20[t] - ema20[t-6]) / max(6 * atr14, 1e-12)"
    },
    "efficiency_ratio_20": {
      "type": "derived",
      "formula": "abs(close[t] - close[t-20]) / max(sum(abs(close[i]-close[i-1]), i=t-19..t), 1e-12)"
    },
    "atr_ratio_20": {
      "type": "derived",
      "formula": "atr14 / max(SMA(atr14,20), 1e-12)"
    },
    "volume_z20": {
      "type": "derived",
      "formula": "(volume - SMA(volume,20)) / max(STD(volume,20), 1e-12)"
    },
    "return_1m": {
      "type": "derived",
      "formula": "close_1m[t] / close_1m[t-1] - 1"
    },
    "return_24h": {
      "type": "derived",
      "formula": "close_1h[t] / close_1h[t-24] - 1"
    },
    "breadth_24h": {
      "type": "cross_sectional",
      "formula": "count(valid_universe_symbols where return_24h > 0) / max(valid_universe_count,1)"
    },
    "realized_vol_5m": {
      "type": "derived",
      "formula": "sqrt(sum(log_return_1m^2 over last 5 bars))"
    },
    "rv5m_ratio_30d": {
      "type": "derived",
      "formula": "realized_vol_5m / max(median(realized_vol_5m over rolling_30d), 1e-12)"
    },
    "spread_bps": {
      "type": "microstructure",
      "formula": "(best_ask - best_bid) / max((best_ask + best_bid)/2,1e-12) * 10000"
    },
    "depth_imbalance": {
      "type": "microstructure",
      "formula": "(bid_depth - ask_depth) / max(bid_depth + ask_depth,1e-12)"
    },
    "aggressive_buy_ratio": {
      "type": "microstructure",
      "formula": "aggressive_buy_volume_1m / max(median(aggressive_buy_volume_1m over rolling_5m),1e-12)"
    },
    "aggressive_sell_ratio": {
      "type": "microstructure",
      "formula": "aggressive_sell_volume_1m / max(median(aggressive_sell_volume_1m over rolling_5m),1e-12)"
    },
    "price_impact_buy": {
      "type": "microstructure",
      "formula": "positive_return_1m / max(aggressive_buy_volume_1m,1e-12)"
    },
    "price_impact_sell": {
      "type": "microstructure",
      "formula": "abs(negative_return_1m) / max(aggressive_sell_volume_1m,1e-12)"
    }
  },
  "global_risk": {
    "max_initial_risk_all_open_positions_pct_equity": 0.025,
    "max_same_direction_risk_pct_equity": 0.0175,
    "max_correlated_bucket_risk_pct_equity": 0.0125,
    "single_symbol_initial_risk_cap_pct_equity": 0.0075,
    "correlation_threshold": 0.75,
    "correlation_lookback_days": 30,
    "daily_loss_controls": [
      {
        "threshold_pct_equity": -0.01,
        "new_risk_multiplier": 0.75
      },
      {
        "threshold_pct_equity": -0.02,
        "new_risk_multiplier": 0.5
      },
      {
        "threshold_pct_equity": -0.03,
        "new_entries_enabled": false
      }
    ],
    "drawdown_controls": [
      {
        "threshold_from_high": -0.05,
        "portfolio_risk_multiplier": 0.75
      },
      {
        "threshold_from_high": -0.08,
        "portfolio_risk_multiplier": 0.5
      },
      {
        "threshold_from_high": -0.12,
        "new_entries_enabled": false,
        "manual_review_required": true
      }
    ]
  },
  "S1_trend": {
    "enabled": true,
    "timeframe": "1h",
    "risk_per_trade_pct_equity": 0.004,
    "risk_per_trade_allowed": [
      0.0025,
      0.004,
      0.006
    ],
    "strategy_initial_risk_cap_pct_equity": 0.0125,
    "leverage_cap": 6.0,
    "trend_quality_score": {
      "formula": "25*adx_component + 25*slope_component + 20*breakout_component + 15*volume_component + 15*volatility_component",
      "components": {
        "adx_component": "clip((adx14-18)/(35-18),0,1)",
        "slope_component": "clip(abs(trend_slope_6)/0.12,0,1)",
        "breakout_component": "1 if long:close>=HHV(high,20) or short:close<=LLV(low,20) else clip(abs(trend_separation)/1.0,0,1)",
        "volume_component": "clip((volume_z20+0.5)/2.5,0,1)",
        "volatility_component": "1 if 0.75<=atr_ratio_20<=1.50 else 0.5 if 0.60<=atr_ratio_20<=1.75 else 0"
      },
      "entry_threshold": 70.0
    },
    "long_entry": {
      "logic": "and",
      "conditions": [
        {
          "lhs": "close",
          "op": "gt",
          "rhs": "ema20"
        },
        {
          "lhs": "ema20",
          "op": "gt",
          "rhs": "ema50"
        },
        {
          "lhs": "trend_slope_6",
          "op": "gt",
          "rhs": 0.0
        },
        {
          "lhs": "trend_quality_score",
          "op": "gte",
          "rhs": 70.0
        },
        {
          "lhs": "S3.direction_bias",
          "op": "gt",
          "rhs": 0.0
        },
        {
          "lhs": "S3.regime",
          "op": "in",
          "rhs": [
            "strong_trend",
            "weak_trend",
            "recovery"
          ]
        },
        {
          "lhs": "atr_ratio_20",
          "op": "lte",
          "rhs": 1.5
        },
        {
          "lhs": "expected_edge_after_cost_R",
          "op": "gte",
          "rhs": 0.15
        }
      ]
    },
    "short_entry": {
      "logic": "and",
      "conditions": [
        {
          "lhs": "close",
          "op": "lt",
          "rhs": "ema20"
        },
        {
          "lhs": "ema20",
          "op": "lt",
          "rhs": "ema50"
        },
        {
          "lhs": "trend_slope_6",
          "op": "lt",
          "rhs": 0.0
        },
        {
          "lhs": "trend_quality_score",
          "op": "gte",
          "rhs": 70.0
        },
        {
          "lhs": "S3.direction_bias",
          "op": "lt",
          "rhs": 0.0
        },
        {
          "lhs": "S3.regime",
          "op": "in",
          "rhs": [
            "strong_trend",
            "weak_trend",
            "recovery"
          ]
        },
        {
          "lhs": "atr_ratio_20",
          "op": "lte",
          "rhs": 1.5
        },
        {
          "lhs": "expected_edge_after_cost_R",
          "op": "gte",
          "rhs": 0.15
        }
      ]
    },
    "hard_blocks": [
      {
        "lhs": "S3.regime",
        "op": "eq",
        "rhs": "range"
      },
      {
        "lhs": "S3.regime",
        "op": "eq",
        "rhs": "panic"
      },
      {
        "lhs": "S6.level",
        "op": "gte",
        "rhs": 2
      }
    ],
    "stop": {
      "initial_distance_formula": "min(1.5*atr14, structure_invalidation_distance)",
      "minimum_stop_distance_bps": 10
    },
    "exit": {
      "breakeven_trigger_R": 1.0,
      "trailing_trigger_R": 2.0,
      "trailing_distance_formula": "max(1.2*atr14, structure_trailing_distance)",
      "time_stop_bars": 12,
      "time_stop_min_unrealized_R": 0.5
    },
    "cooldown": {
      "after_stop_bars": 3,
      "after_two_losses_same_symbol_bars": 6
    },
    "trade_intent": {
      "emit_when_entry_rule_passes": true,
      "initial_status": "WAITING_EXECUTION_CONFIRMATION",
      "lifecycle_policy_ref": "signal_lifecycle.strategy_policy.S1"
    }
  },
  "S2_reversal": {
    "enabled": true,
    "timeframe": "15m",
    "risk_per_trade_pct_equity": 0.003,
    "countertrend_risk_cap_pct_equity": 0.002,
    "strategy_initial_risk_cap_pct_equity": 0.0075,
    "leverage_cap": 4.0,
    "parameters": {
      "rsi_long_threshold": 25,
      "rsi_short_threshold": 75,
      "funding_low_percentile": 10,
      "funding_high_percentile": 90,
      "oi_flush_threshold": -0.015
    },
    "reversal_confirmation_long": {
      "logic": "and",
      "conditions": [
        {
          "lhs": "new_low_count_last_2_bars",
          "op": "eq",
          "rhs": 0
        },
        {
          "lhs": "close",
          "op": "gt",
          "rhs": "prior_micro_swing_low"
        },
        {
          "lhs": "price_impact_sell",
          "op": "lt",
          "rhs": "rolling_price_impact_sell_p40"
        }
      ]
    },
    "reversal_confirmation_short": {
      "logic": "and",
      "conditions": [
        {
          "lhs": "new_high_count_last_2_bars",
          "op": "eq",
          "rhs": 0
        },
        {
          "lhs": "close",
          "op": "lt",
          "rhs": "prior_micro_swing_high"
        },
        {
          "lhs": "price_impact_buy",
          "op": "lt",
          "rhs": "rolling_price_impact_buy_p40"
        }
      ]
    },
    "trend_acceleration_block_long": {
      "logic": "and",
      "conditions": [
        {
          "lhs": "close",
          "op": "lt",
          "rhs": "ema200"
        },
        {
          "lhs": "adx14",
          "op": "gte",
          "rhs": 35
        },
        {
          "lhs": "volume_z20",
          "op": "gte",
          "rhs": 2.0
        },
        {
          "lhs": "new_low_count_last_3_bars",
          "op": "gte",
          "rhs": 2
        }
      ]
    },
    "trend_acceleration_block_short": {
      "logic": "and",
      "conditions": [
        {
          "lhs": "close",
          "op": "gt",
          "rhs": "ema200"
        },
        {
          "lhs": "adx14",
          "op": "gte",
          "rhs": 35
        },
        {
          "lhs": "volume_z20",
          "op": "gte",
          "rhs": 2.0
        },
        {
          "lhs": "new_high_count_last_3_bars",
          "op": "gte",
          "rhs": 2
        }
      ]
    },
    "long_entry": {
      "logic": "and",
      "conditions": [
        {
          "lhs": "rsi14",
          "op": "lte",
          "rhs": 25
        },
        {
          "lhs": "funding_percentile_180d",
          "op": "lte",
          "rhs": 10
        },
        {
          "lhs": "open_interest_change_1h",
          "op": "lte",
          "rhs": -0.015
        },
        {
          "lhs": "reversal_confirmation_long",
          "op": "eq",
          "rhs": true
        },
        {
          "lhs": "trend_acceleration_block_long",
          "op": "eq",
          "rhs": false
        },
        {
          "lhs": "S6.level",
          "op": "lte",
          "rhs": 1
        },
        {
          "lhs": "expected_edge_after_cost_R",
          "op": "gte",
          "rhs": 0.15
        }
      ]
    },
    "short_entry": {
      "logic": "and",
      "conditions": [
        {
          "lhs": "rsi14",
          "op": "gte",
          "rhs": 75
        },
        {
          "lhs": "funding_percentile_180d",
          "op": "gte",
          "rhs": 90
        },
        {
          "lhs": "open_interest_change_1h",
          "op": "lte",
          "rhs": -0.015
        },
        {
          "lhs": "reversal_confirmation_short",
          "op": "eq",
          "rhs": true
        },
        {
          "lhs": "trend_acceleration_block_short",
          "op": "eq",
          "rhs": false
        },
        {
          "lhs": "S6.level",
          "op": "lte",
          "rhs": 1
        },
        {
          "lhs": "expected_edge_after_cost_R",
          "op": "gte",
          "rhs": 0.15
        }
      ]
    },
    "exit": {
      "initial_stop_formula": "1.0*atr14 beyond confirmed reversal swing",
      "partial_tp": [
        {
          "at_R": 1.0,
          "close_fraction": 0.4
        },
        {
          "at_R": 2.0,
          "close_fraction": 0.4
        }
      ],
      "runner_fraction": 0.2,
      "trailing_trigger_R": 1.5,
      "trailing_distance_atr": 1.0,
      "max_holding_bars": 24
    },
    "trade_intent": {
      "emit_when_entry_rule_passes": true,
      "initial_status": "WAITING_EXECUTION_CONFIRMATION",
      "lifecycle_policy_ref": "signal_lifecycle.strategy_policy.S2"
    }
  },
  "S3_regime": {
    "enabled": true,
    "primary_timeframe": "1d",
    "intraday_override_timeframe": "5m",
    "direction_bias_range": [
      -1.0,
      1.0
    ],
    "confidence_range": [
      0.0,
      1.0
    ],
    "subscores": {
      "trend_strength": {
        "formula": "clip(abs(trend_separation)/1.2,0,1)*0.45 + clip(adx14/40,0,1)*0.35 + clip(efficiency_ratio_20/0.6,0,1)*0.20"
      },
      "trend_direction": {
        "formula": "clip(trend_separation/1.2,-1,1)*0.6 + clip(trend_slope_6/0.12,-1,1)*0.4"
      },
      "breadth_score": {
        "formula": "clip((breadth_24h-0.5)/0.25,-1,1)"
      },
      "volatility_score": {
        "formula": "clip(rv5m_ratio_30d/3.0,0,1)"
      },
      "structure_score": {
        "formula": "clip((efficiency_ratio_20-0.2)/0.4,0,1)"
      }
    },
    "regime_rules_priority": [
      "panic",
      "strong_trend",
      "weak_trend",
      "recovery",
      "range"
    ],
    "regime_rules": {
      "panic": {
        "logic": "or",
        "conditions": [
          {
            "lhs": "rv5m_ratio_30d",
            "op": "gte",
            "rhs": 3.0
          },
          {
            "lhs": "abs(return_1m)",
            "op": "gte",
            "rhs": "rolling_180d_abs_return_1m_p999"
          },
          {
            "lhs": "spread_bps",
            "op": "gte",
            "rhs": "rolling_30d_spread_bps_p99"
          }
        ]
      },
      "strong_trend": {
        "logic": "and",
        "conditions": [
          {
            "lhs": "trend_strength",
            "op": "gte",
            "rhs": 0.7
          },
          {
            "lhs": "abs(trend_direction)",
            "op": "gte",
            "rhs": 0.6
          },
          {
            "lhs": "structure_score",
            "op": "gte",
            "rhs": 0.45
          },
          {
            "lhs": "rv5m_ratio_30d",
            "op": "lt",
            "rhs": 2.0
          }
        ]
      },
      "weak_trend": {
        "logic": "and",
        "conditions": [
          {
            "lhs": "trend_strength",
            "op": "gte",
            "rhs": 0.45
          },
          {
            "lhs": "trend_strength",
            "op": "lt",
            "rhs": 0.7
          },
          {
            "lhs": "abs(trend_direction)",
            "op": "gte",
            "rhs": 0.3
          },
          {
            "lhs": "rv5m_ratio_30d",
            "op": "lt",
            "rhs": 2.5
          }
        ]
      },
      "recovery": {
        "logic": "and",
        "conditions": [
          {
            "lhs": "was_panic_within_last_24h",
            "op": "eq",
            "rhs": true
          },
          {
            "lhs": "rv5m_ratio_30d",
            "op": "lte",
            "rhs": 1.5
          },
          {
            "lhs": "breadth_24h",
            "op": "gte",
            "rhs": 0.55
          },
          {
            "lhs": "structure_score",
            "op": "gte",
            "rhs": 0.35
          }
        ]
      },
      "range": {
        "logic": "and",
        "conditions": [
          {
            "lhs": "trend_strength",
            "op": "lt",
            "rhs": 0.45
          },
          {
            "lhs": "efficiency_ratio_20",
            "op": "lt",
            "rhs": 0.3
          },
          {
            "lhs": "rv5m_ratio_30d",
            "op": "lt",
            "rhs": 2.0
          }
        ]
      }
    },
    "direction_bias": {
      "formula": "clip(0.65*trend_direction + 0.20*breadth_score + 0.15*derivatives_direction_score,-1,1)"
    },
    "confidence": {
      "formula": "clip(0.45*trend_strength + 0.25*structure_score + 0.15*abs(breadth_score) + 0.15*factor_agreement_score,0,1)"
    },
    "risk_multiplier_by_regime": {
      "strong_trend": 1.0,
      "weak_trend": 0.65,
      "range": 0.4,
      "panic": 0.2,
      "recovery": 0.5
    },
    "fallback": {
      "when_no_rule_matches": "range",
      "on_core_data_failure": {
        "regime": "panic",
        "direction_bias": 0.0,
        "confidence": 0.0,
        "block_directional_entries": true
      }
    }
  },
  "S4_execution": {
    "enabled": true,
    "role": "execution_timing_only",
    "can_create_directional_thesis": false,
    "decision_window_seconds": 10,
    "risk_multiplier_degraded": 0.5,
    "data_modes": {
      "FULL": {
        "required": [
          "trades",
          "top_of_book",
          "depth"
        ],
        "risk_multiplier": 1.0
      },
      "DEGRADED": {
        "required": [
          "trades",
          "top_of_book"
        ],
        "risk_multiplier": 0.5
      },
      "OFF": {
        "trigger_any": [
          {
            "lhs": "market_data_stale_ms",
            "op": "gt",
            "rhs": 2000
          },
          {
            "lhs": "sequence_gap_ms",
            "op": "gt",
            "rhs": 2000
          },
          {
            "lhs": "sequence_valid",
            "op": "eq",
            "rhs": false
          }
        ]
      }
    },
    "long_confirm": {
      "logic": "and",
      "conditions": [
        {
          "lhs": "authorized_direction",
          "op": "eq",
          "rhs": "long"
        },
        {
          "lhs": "aggressive_buy_ratio",
          "op": "gte",
          "rhs": 3.0
        },
        {
          "lhs": "price_impact_buy",
          "op": "lte",
          "rhs": "rolling_price_impact_buy_p40"
        },
        {
          "lhs": "depth_imbalance",
          "op": "gte",
          "rhs": 0.1
        },
        {
          "lhs": "spread_bps",
          "op": "lte",
          "rhs": "rolling_30d_spread_bps_p80"
        }
      ]
    },
    "short_confirm": {
      "logic": "and",
      "conditions": [
        {
          "lhs": "authorized_direction",
          "op": "eq",
          "rhs": "short"
        },
        {
          "lhs": "aggressive_sell_ratio",
          "op": "gte",
          "rhs": 3.0
        },
        {
          "lhs": "price_impact_sell",
          "op": "lte",
          "rhs": "rolling_price_impact_sell_p40"
        },
        {
          "lhs": "depth_imbalance",
          "op": "lte",
          "rhs": -0.1
        },
        {
          "lhs": "spread_bps",
          "op": "lte",
          "rhs": "rolling_30d_spread_bps_p80"
        }
      ]
    },
    "max_expected_slippage_fraction_of_stop": 0.2,
    "max_entries_per_hour": 12,
    "max_entries_per_day": 30,
    "input_contract": {
      "required_object": "TradeIntent",
      "required_status": "WAITING_EXECUTION_CONFIRMATION",
      "reject_if_expired": true,
      "reject_if_price_drift_invalid": true,
      "revalidate_source_strategy_before_confirmation": true
    },
    "confirmation_must_occur_before_trade_intent_expiry": true
  },
  "S5_risk_budget": {
    "enabled": true,
    "reserve_fraction": 0.15,
    "base_strategy_shares": {
      "S1": 0.5,
      "S2": 0.25,
      "S4": 0.1
    },
    "regime_multipliers": {
      "strong_trend": {
        "S1": 1.2,
        "S2": 0.6,
        "S4": 1.0
      },
      "weak_trend": {
        "S1": 0.9,
        "S2": 0.9,
        "S4": 0.8
      },
      "range": {
        "S1": 0.3,
        "S2": 1.2,
        "S4": 0.7
      },
      "panic": {
        "S1": 0.2,
        "S2": 0.2,
        "S4": 0.25
      },
      "recovery": {
        "S1": 0.7,
        "S2": 0.8,
        "S4": 0.6
      }
    },
    "health_multipliers": {
      "80_100": 1.0,
      "60_79": 0.75,
      "40_59": 0.5,
      "0_39": 0.0
    },
    "allocation_formula": {
      "raw_share_i": "base_share_i * regime_multiplier_i * health_multiplier_i",
      "raw_sum": "sum(raw_share_i for all strategies)",
      "max_allocatable_share": "1 - reserve_fraction",
      "scale": "min(1, max_allocatable_share / max(raw_sum, 1e-12))",
      "final_share_i": "raw_share_i * scale",
      "unused_share": "1 - sum(final_share_i)",
      "invariant": "sum(final_share_i) <= 1 - reserve_fraction"
    },
    "risk_budget_formula": {
      "portfolio_risk_budget_pct_equity": "global_risk.max_initial_risk_all_open_positions_pct_equity * global_drawdown_multiplier * daily_loss_multiplier * S3.risk_multiplier",
      "strategy_risk_budget_pct_equity_i": "portfolio_risk_budget_pct_equity * final_share_i"
    }
  },
