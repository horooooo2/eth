              "incident_id",
              "operator_id",
              "reason"
            ],
            "optional_fields": [
              "ticket_id",
              "comment"
            ]
          },
          "preconditions": [
            {
              "lhs": "exchange_connected",
              "op": "eq",
              "rhs": true
            },
            {
              "lhs": "market_data_stale_ms",
              "op": "lt",
              "rhs": 250
            },
            {
              "lhs": "sequence_valid",
              "op": "eq",
              "rhs": true
            },
            {
              "lhs": "positions_reconciled",
              "op": "eq",
              "rhs": true
            },
            {
              "lhs": "orders_reconciled",
              "op": "eq",
              "rhs": true
            },
            {
              "lhs": "risk_engine_healthy",
              "op": "eq",
              "rhs": true
            },
            {
              "lhs": "incident_open",
              "op": "eq",
              "rhs": true
            }
          ],
          "actions_on_success": [
            "record_manual_ack",
            "append_operator_identity_to_audit_log",
            "transition_S6_level_3_to_level_2",
            "start_market_recovery_observation_window"
          ],
          "direct_level_3_to_level_0_allowed": false,
          "response_schema": {
