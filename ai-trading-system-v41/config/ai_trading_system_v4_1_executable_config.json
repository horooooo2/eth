        "new_entries_enabled": false,
        "risk_reducing_orders_only": true
      },
      "3": {
        "new_entries_enabled": false,
        "cancel_pending_entry_orders": true,
        "reconcile_positions": true,
        "emergency_exit_policy_allowed": true
      }
    },
    "recovery": {
      "hysteresis_enabled": true,
      "market_anomaly_auto_resume": {
        "eligible_events": [
          "flash_move",
          "volatility_shock",
          "spread_shock",
          "liquidity_vacuum"
        ],
        "required_consecutive_1m_bars": 20,
        "conditions": [
          {
            "lhs": "rv5m_ratio_30d",
            "op": "lte",
            "rhs": 1.5
          },
          {
            "lhs": "spread_bps",
            "op": "lte",
            "rhs": "rolling_30d_spread_bps_p80"
          },
          {
            "lhs": "top_book_depth",
            "op": "gte",
            "rhs": "rolling_30d_depth_p20"
          },
          {
            "lhs": "market_data_stale_ms",
            "op": "lt",
            "rhs": 250
          },
          {
            "lhs": "sequence_valid",
            "op": "eq",
            "rhs": true
          },
          {
            "lhs": "exchange_connected",
            "op": "eq",
            "rhs": true
          }
        ],
        "step_down_state_machine": [
          {
            "from": 3,
            "to": 2,
            "after_conditions_pass_minutes": 20
          },
          {
            "from": 2,
            "to": 1,
            "after_conditions_pass_minutes": 10
          },
          {
            "from": 1,
            "to": 0,
            "after_conditions_pass_minutes": 10
          }
