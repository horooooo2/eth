        "S4 confirmation or configured S4 bypass policy",
        "source strategy revalidation",
        "expected edge recalculated",
        "S5 risk budget resolved",
        "S6 safety gate passed",
        "S7 health gate passed"
      ],
      "order_intent_must_reference_trade_intent_id": true
    }
