{
  "schema_version": "1.0",
  "config_type": "SYSTEM_MODULE",
  "module_id": "S3",
  "name": "Market Regime",
  "display": {
    "summary_zh": "负责判断当前市场状态和方向偏向，为 Alpha 策略提供是否允许开仓及风险调整依据。"
  },
  "release_stage": "PRODUCTION",
  "implemented": true,
  "enabled": true,
  "primary_timeframe": "1d",
  "intraday_override_timeframe": "5m",
  "direction_bias_range": [
    -1.0,
    1.0
  ],
  "confidence_range": [
    0.0,
    1.0
  ],
  "subscores": {
    "trend_strength": {
      "formula": "clip(abs(trend_separation)/1.2,0,1)*0.45 + clip(adx14/40,0,1)*0.35 + clip(efficiency_ratio_20/0.6,0,1)*0.20"
    },
    "trend_direction": {
      "formula": "clip(trend_separation/1.2,-1,1)*0.6 + clip(trend_slope_6/0.12,-1,1)*0.4"
    },
    "breadth_score": {
      "formula": "clip((breadth_24h-0.5)/0.25,-1,1)"
    },
    "volatility_score": {
      "formula": "clip(rv5m_ratio_30d/3.0,0,1)"
    },
    "structure_score": {
      "formula": "clip((efficiency_ratio_20-0.2)/0.4,0,1)"
    }
  },
  "regime_rules_priority": [
    "panic",
    "strong_trend",
    "weak_trend",
    "recovery",
    "range"
  ],
  "regime_rules": {
    "panic": {
      "logic": "or",
      "conditions": [
        {
          "lhs": "rv5m_ratio_30d",
          "op": "gte",
          "rhs": 3.0
        },
        {
          "lhs": "abs(return_1m)",
          "op": "gte",
          "rhs": "rolling_180d_abs_return_1m_p999"
        },
        {
          "lhs": "spread_bps",
          "op": "gte",
          "rhs": "rolling_30d_spread_bps_p99"
        }
      ]
    },
    "strong_trend": {
      "logic": "and",
      "conditions": [
        {
          "lhs": "trend_strength",
          "op": "gte",
          "rhs": 0.7
        },
        {
          "lhs": "abs(trend_direction)",
          "op": "gte",
          "rhs": 0.6
        },
        {
          "lhs": "structure_score",
          "op": "gte",
          "rhs": 0.45
        },
        {
          "lhs": "rv5m_ratio_30d",
          "op": "lt",
          "rhs": 2.0
        }
      ]
    },
    "weak_trend": {
      "logic": "and",
      "conditions": [
        {
          "lhs": "trend_strength",
          "op": "gte",
          "rhs": 0.45
        },
        {
          "lhs": "trend_strength",
          "op": "lt",
          "rhs": 0.7
        },
        {
          "lhs": "abs(trend_direction)",
          "op": "gte",
          "rhs": 0.3
        },
        {
          "lhs": "rv5m_ratio_30d",
          "op": "lt",
          "rhs": 2.5
        }
      ]
    },
    "recovery": {
      "logic": "and",
      "conditions": [
        {
          "lhs": "was_panic_within_last_24h",
          "op": "eq",
          "rhs": true
        },
        {
          "lhs": "rv5m_ratio_30d",
          "op": "lte",
          "rhs": 1.5
        },
        {
          "lhs": "breadth_24h",
          "op": "gte",
          "rhs": 0.55
        },
        {
          "lhs": "structure_score",
          "op": "gte",
          "rhs": 0.35
        }
      ]
    },
    "range": {
      "logic": "and",
      "conditions": [
        {
          "lhs": "trend_strength",
          "op": "lt",
          "rhs": 0.45
        },
        {
          "lhs": "efficiency_ratio_20",
          "op": "lt",
          "rhs": 0.3
        },
        {
          "lhs": "rv5m_ratio_30d",
          "op": "lt",
          "rhs": 2.0
        }
      ]
    }
  },
  "direction_bias": {
    "formula": "clip(0.65*trend_direction + 0.20*breadth_score + 0.15*derivatives_direction_score,-1,1)"
  },
  "confidence": {
    "formula": "clip(0.45*trend_strength + 0.25*structure_score + 0.15*abs(breadth_score) + 0.15*factor_agreement_score,0,1)"
  },
  "risk_multiplier_by_regime": {
    "strong_trend": 1.0,
    "weak_trend": 0.65,
    "range": 0.4,
    "panic": 0.2,
    "recovery": 0.5
  },
  "fallback": {
    "when_no_rule_matches": "range",
    "on_core_data_failure": {
      "regime": "panic",
      "direction_bias": 0.0,
      "confidence": 0.0,
      "block_directional_entries": true
    }
  }
}
