{
  "schema_version": "1.0",
  "config_type": "SYSTEM_MODULE",
  "module_id": "S4",
  "name": "Execution Timing",
  "release_stage": "PRODUCTION",
  "implemented": true,
  "enabled": true,
  "role": "execution_timing_only",
  "can_create_directional_thesis": false,
  "decision_window_seconds": 10,
  "risk_multiplier_degraded": 0.5,
  "data_modes": {
    "FULL": {
      "required": [
        "trades",
        "top_of_book",
        "depth"
      ],
      "risk_multiplier": 1.0
    },
    "DEGRADED": {
      "required": [
        "trades",
        "top_of_book"
      ],
      "risk_multiplier": 0.5
    },
    "OFF": {
      "trigger_any": [
        {
          "lhs": "market_data_stale_ms",
          "op": "gt",
          "rhs": 2000
        },
        {
          "lhs": "sequence_gap_ms",
          "op": "gt",
          "rhs": 2000
        },
        {
          "lhs": "sequence_valid",
          "op": "eq",
          "rhs": false
        }
      ]
    }
  },
  "long_confirm": {
    "logic": "and",
    "conditions": [
      {
        "lhs": "authorized_direction",
        "op": "eq",
        "rhs": "long"
      },
      {
        "lhs": "aggressive_buy_ratio",
        "op": "gte",
        "rhs": 3.0
      },
      {
        "lhs": "price_impact_buy",
        "op": "lte",
        "rhs": "rolling_price_impact_buy_p40"
      },
      {
        "lhs": "depth_imbalance",
        "op": "gte",
        "rhs": 0.1
      },
      {
        "lhs": "spread_bps",
        "op": "lte",
        "rhs": "rolling_30d_spread_bps_p80"
      }
    ]
  },
  "short_confirm": {
    "logic": "and",
    "conditions": [
      {
        "lhs": "authorized_direction",
        "op": "eq",
        "rhs": "short"
      },
      {
        "lhs": "aggressive_sell_ratio",
        "op": "gte",
        "rhs": 3.0
      },
      {
        "lhs": "price_impact_sell",
        "op": "lte",
        "rhs": "rolling_price_impact_sell_p40"
      },
      {
        "lhs": "depth_imbalance",
        "op": "lte",
        "rhs": -0.1
      },
      {
        "lhs": "spread_bps",
        "op": "lte",
        "rhs": "rolling_30d_spread_bps_p80"
      }
    ]
  },
  "max_expected_slippage_fraction_of_stop": 0.2,
  "max_entries_per_hour": 12,
  "max_entries_per_day": 30,
  "input_contract": {
    "required_object": "TradeIntent",
    "required_status": "WAITING_EXECUTION_CONFIRMATION",
    "reject_if_expired": true,
    "reject_if_price_drift_invalid": true,
    "revalidate_source_strategy_before_confirmation": true
  },
  "confirmation_must_occur_before_trade_intent_expiry": true
}
