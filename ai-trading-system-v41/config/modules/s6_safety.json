{
  "schema_version": "1.0",
  "config_type": "SYSTEM_MODULE",
  "module_id": "S6",
  "name": "Safety",
  "display": {
    "summary_zh": "负责监控异常与安全等级，在风险扩大时阻止新开仓，并在必要时升级保护措施。"
  },
  "release_stage": "PRODUCTION",
  "implemented": true,
  "enabled": true,
  "evaluation_interval_seconds": 5,
  "level": 0,
  "signals": {
    "flash_move": {
      "metric": "abs(return_1m)",
      "levels": {
        "1": {
          "op": "gte",
          "threshold": "rolling_180d_abs_return_1m_p99"
        },
        "2": {
          "op": "gte",
          "threshold": "rolling_180d_abs_return_1m_p999"
        },
        "3": {
          "op": "gte",
          "threshold": "rolling_180d_abs_return_1m_p9999"
        }
      }
    },
    "volatility_shock": {
      "metric": "rv5m_ratio_30d",
      "levels": {
        "1": {
          "op": "gte",
          "threshold": 2.0
        },
        "2": {
          "op": "gte",
          "threshold": 3.0
        },
        "3": {
          "op": "gte",
          "threshold": 5.0
        }
      }
    },
    "spread_shock": {
      "metric": "spread_bps",
      "levels": {
        "1": {
          "op": "gte",
          "threshold": "rolling_30d_spread_bps_p95"
        },
        "2": {
          "op": "gte",
          "threshold": "rolling_30d_spread_bps_p99"
        },
        "3": {
          "op": "gte",
          "threshold": "rolling_30d_spread_bps_p999"
        }
      }
    },
    "liquidity_vacuum": {
      "metric": "top_book_depth",
      "levels": {
        "1": {
          "op": "lte",
          "threshold": "rolling_30d_depth_p10"
        },
        "2": {
          "op": "lte",
          "threshold": "rolling_30d_depth_p05"
        },
        "3": {
          "op": "lte",
          "threshold": "rolling_30d_depth_p01"
        }
      }
    },
    "market_data_stale": {
      "metric": "market_data_stale_ms",
      "levels": {
        "1": {
          "op": "gte",
          "threshold": 500
        },
        "2": {
          "op": "gte",
          "threshold": 2000
        },
        "3": {
          "op": "gte",
          "threshold": 5000
        }
      }
    }
  },
  "hard_level_3_system_events": [
    "position_mismatch",
    "unexpected_leverage",
    "risk_engine_unavailable",
    "order_reconciliation_failure",
    "exchange_connectivity_lost"
  ],
  "aggregation_rule": {
    "formula": "max(all_signal_levels, hard_system_event_level)",
    "hard_system_event_level": 3
  },
  "actions_by_level": {
    "0": {
      "new_entries_enabled": true,
      "risk_multiplier": 1.0
    },
    "1": {
      "new_entries_enabled": true,
      "risk_multiplier": 0.5
    },
    "2": {
      "new_entries_enabled": false,
      "risk_reducing_orders_only": true
    },
    "3": {
      "new_entries_enabled": false,
      "cancel_pending_entry_orders": true,
      "reconcile_positions": true,
      "emergency_exit_policy_allowed": true
    }
  },
  "recovery": {
    "hysteresis_enabled": true,
    "market_anomaly_auto_resume": {
      "eligible_events": [
        "flash_move",
        "volatility_shock",
        "spread_shock",
        "liquidity_vacuum"
      ],
      "required_consecutive_1m_bars": 20,
      "conditions": [
        {
          "lhs": "rv5m_ratio_30d",
          "op": "lte",
          "rhs": 1.5
        },
        {
          "lhs": "spread_bps",
          "op": "lte",
          "rhs": "rolling_30d_spread_bps_p80"
        },
        {
          "lhs": "top_book_depth",
          "op": "gte",
          "rhs": "rolling_30d_depth_p20"
        },
        {
          "lhs": "market_data_stale_ms",
          "op": "lt",
          "rhs": 250
        },
        {
          "lhs": "sequence_valid",
          "op": "eq",
          "rhs": true
        },
        {
          "lhs": "exchange_connected",
          "op": "eq",
          "rhs": true
        }
      ],
      "step_down_state_machine": [
        {
          "from": 3,
          "to": 2,
          "after_conditions_pass_minutes": 20
        },
        {
          "from": 2,
          "to": 1,
          "after_conditions_pass_minutes": 10
        },
        {
          "from": 1,
          "to": 0,
          "after_conditions_pass_minutes": 10
        }
      ]
    },
    "system_anomaly_manual_resume": {
      "events": [
        "position_mismatch",
        "unexpected_leverage",
        "risk_engine_unavailable",
        "order_reconciliation_failure",
        "exchange_connectivity_lost"
      ],
      "auto_resume": false,
      "requirements": [
        "exchange_connected == true",
        "market_data_stale_ms < 250",
        "sequence_valid == true",
        "positions_reconciled == true",
        "orders_reconciled == true",
        "risk_engine_healthy == true",
        "manual_ack == true",
        "manual_ack must originate from manual_resume_control endpoint"
      ],
      "manual_resume_control": {
        "enabled": true,
        "endpoint": "/api/v1/system/resume",
        "method": "POST",
        "transport": "HTTPS",
        "authentication_required": true,
        "authorization": {
          "required_role": "risk_admin",
          "multi_factor_auth_recommended": true
        },
        "idempotency": {
          "required": true,
          "header": "Idempotency-Key"
        },
        "request_schema": {
          "required_fields": [
            "incident_id",
            "operator_id",
            "reason"
          ],
          "optional_fields": [
            "ticket_id",
            "comment"
          ]
        },
        "preconditions": [
          {
            "lhs": "exchange_connected",
            "op": "eq",
            "rhs": true
          },
          {
            "lhs": "market_data_stale_ms",
            "op": "lt",
            "rhs": 250
          },
          {
            "lhs": "sequence_valid",
            "op": "eq",
            "rhs": true
          },
          {
            "lhs": "positions_reconciled",
            "op": "eq",
            "rhs": true
          },
          {
            "lhs": "orders_reconciled",
            "op": "eq",
            "rhs": true
          },
          {
            "lhs": "risk_engine_healthy",
            "op": "eq",
            "rhs": true
          },
          {
            "lhs": "incident_open",
            "op": "eq",
            "rhs": true
          }
        ],
        "actions_on_success": [
          "record_manual_ack",
          "append_operator_identity_to_audit_log",
          "transition_S6_level_3_to_level_2",
          "start_market_recovery_observation_window"
        ],
        "direct_level_3_to_level_0_allowed": false,
        "response_schema": {
          "success": [
            "incident_id",
            "previous_level",
            "new_level",
            "recovery_observation_started_at",
            "audit_event_id"
          ],
          "failure": [
            "incident_id",
            "rejected_preconditions",
            "error_code"
          ]
        },
        "audit": {
          "required": true,
          "immutable_log": true,
          "fields": [
            "timestamp",
            "incident_id",
            "operator_id",
            "source_ip",
            "reason",
            "precondition_snapshot",
            "previous_level",
            "new_level"
          ]
        }
      }
    }
  }
}
