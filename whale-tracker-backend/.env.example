# 默认走官方 Hyperliquid（不配 Key、不设 HL_USE_GOLDRUSH）
# HL_INFO_URL=https://api.hyperliquid.xyz/info
# HL_WS_URL=wss://api.hyperliquid.xyz/ws

# 可选：显式启用 GoldRush（需积分）
# HL_USE_GOLDRUSH=1
# GOLDRUSH_API_KEY=

# 失败回退（默认开；官方为主时几乎用不到）
# HL_INFO_FALLBACK=1

# 并发（官方建议 1～2）
HL_MAX_CONCURRENT=2
# HL_INFO_TIMEOUT_MS=30000
WHALE_SNAPSHOT_CONCURRENCY=2
WHALE_SHARD_SIZE=10

# 仓位分片刷新（毫秒），默认 5 分钟
REFRESH_INTERVAL=300000

# 成交 WS：仅订阅有仓地址（按仓位价值优先），默认最多 60
# FILL_SUB_TOP_N=60
# FILL_SUB_MIN_USD=1000

# 资金动态：1 天 / 每鲸最多 200 条
# FILL_RETENTION_DAYS=1
# FILL_MAX_PER_WHALE=200

# 仓位事件：最小名义、10s 合并；持仓中保留，已平仓再留 1 天
# POSITION_EVENT_MIN_USD=1000
# POSITION_EVENT_MERGE_MS=10000
# CLOSED_POSITION_RETENTION_DAYS=1

# 当前持仓慢补更久开/加仓史（默认开）
# POSITION_BACKFILL=1
# POSITION_BACKFILL_INTERVAL_MS=8000
# POSITION_BACKFILL_DAYS=180

# 重启后慢补成交：默认关；需要时设 FILL_BACKFILL=1
# FILL_BACKFILL=1
# FILL_BACKFILL_INTERVAL_MS=5000
# FILL_BACKFILL_RATE_LIMIT_MS=1800000
# FILL_BACKFILL_DAYS=1

# TOP_WHALE_LIMIT=200

PORT=80

# 鲸鱼AI → OKX 交易（必须由各用户在前端绑定自己的 Key；禁止在服务器设全局交易 Key）
# 不要配置 OKX_API_KEY / OKX_API_SECRET / OKX_API_PASSPHRASE（多用户会串仓）
# 仅本地调试脚本可临时：OKX_ALLOW_ENV_CREDS=1 + 上述三项
# OKX_TRADE_BASE=https://www.okx.com
# OKX_PROXY=http://127.0.0.1:7890
# OKX_FORCE_IPV4=1
# OKX_TIMEOUT_MS=60000

# V4.1 Python 量化引擎（仅 Node 内网访问）
V41_ENGINE_ENABLED=true
V41_ENGINE_BASE_URL=http://127.0.0.1:8711
V41_ENGINE_TIMEOUT_MS=3000
V41_ENGINE_INTERNAL_TOKEN=dev-internal-token
V41_ALPHA_EXECUTION=SHADOW
# SHADOW | EXECUTE  (preferred)
V41_ENGINE_EXECUTION_MODE=node_gateway_shadow
# legacy: paper → SHADOW, node_gateway_shadow → SHADOW, node_gateway → EXECUTE
V41_LIVE_TRADING_ENABLED=false
# OKX Live key ≠ live trading. Default must stay false.
# V41_MARKET_DATA_SOURCE=okx
# V41_ENGINE_OWNER_USER_ID=
# V41_RESUME_ADMINS=admin,risk_admin_01
# V41_NODE_GATEWAY_URL=http://127.0.0.1:80
# V41_ENGINE_STALE_MS=10000
# V41_ENGINE_OFFLINE_MS=30000

# QA-HFT-SIM + OKX 模拟盘开平仓测试（线上 deploy 会写成 true；实盘 QA 仍默认关）
V41_HFT_SIM_ENABLED=true

# Allow QA-HFT to route through Node Gateway → OKX (demo/live from user.simulated)
V41_QA_EXCHANGE_ENABLED=true

# Allow QA-HFT on OKX LIVE accounts (requires QA_EXCHANGE_ENABLED). Default OFF.
V41_QA_LIVE_ENABLED=false

# E1 Whale data bridge → Python (telemetry only; S8 Alpha NOT enabled)
V41_WHALE_BRIDGE_ENABLED=false
# V41_WHALE_BRIDGE_INTERVAL_MS=5000
# V41_WHALE_BRIDGE_MODE=hf

# X / Sorsa（只拉 user-tweets，默认 30 分钟；北京时间 9:00–次日 3:00）
# SORSA_API_KEY=
# X_POLL=1
# X_POLL_INTERVAL_MS=1800000
# X_PER_USER_KEEP=15
# X_USER_GAP_MS=1500
