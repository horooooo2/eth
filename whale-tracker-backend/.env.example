# 默认走官方 Hyperliquid（不配 Key、不设 HL_USE_GOLDRUSH）
# HL_INFO_URL=https://api.hyperliquid.xyz/info
# HL_WS_URL=wss://api.hyperliquid.xyz/ws

# 可选：显式启用 GoldRush（需积分）
# HL_USE_GOLDRUSH=1
# GOLDRUSH_API_KEY=

# 失败回退（默认开；官方为主时几乎用不到）
# HL_INFO_FALLBACK=1

# 并发（官方建议 1～2）
HL_MAX_CONCURRENT=2
# HL_INFO_TIMEOUT_MS=30000
WHALE_SNAPSHOT_CONCURRENCY=2
WHALE_SHARD_SIZE=10

# 仓位分片刷新（毫秒），默认 5 分钟
REFRESH_INTERVAL=300000

# 成交 WS：仅订阅有仓地址（按仓位价值优先），默认最多 60
# FILL_SUB_TOP_N=60
# FILL_SUB_MIN_USD=1000

# 资金动态：1 天 / 每鲸最多 200 条
# FILL_RETENTION_DAYS=1
# FILL_MAX_PER_WHALE=200

# 仓位事件：最小名义、10s 合并；持仓中保留，已平仓再留 1 天
# POSITION_EVENT_MIN_USD=1000
# POSITION_EVENT_MERGE_MS=10000
# CLOSED_POSITION_RETENTION_DAYS=1

# 当前持仓慢补更久开/加仓史（默认开）
# POSITION_BACKFILL=1
# POSITION_BACKFILL_INTERVAL_MS=8000
# POSITION_BACKFILL_DAYS=180

# 重启后慢补成交：默认关；需要时设 FILL_BACKFILL=1
# FILL_BACKFILL=1
# FILL_BACKFILL_INTERVAL_MS=5000
# FILL_BACKFILL_RATE_LIMIT_MS=1800000
# FILL_BACKFILL_DAYS=1

# TOP_WHALE_LIMIT=200
# OKX 跟单监控（公开 API，无需 Key）
# 境内云主机常无法直连 www.okx.com，可选：
# 1) 配代理 OKX_PROXY=http://127.0.0.1:7890
# 2) 本机推送：node scripts/push-okx-cache.js http://你的服务器
# 3) 上游镜像 OKX_UPSTREAM=http://可访问OKX的机器/api/okx
# OKX_BASE=https://www.okx.com
# OKX_TOP_N=50
# OKX_INST_TYPE=SWAP
# OKX_SORT_TYPE=pnl_ratio
# OKX_POLL=1
# OKX_POLL_INTERVAL_MS=30000
# OKX_REQUEST_GAP_MS=180
# OKX_TIMEOUT_MS=60000
# OKX_RETRIES=2
# OKX_FORCE_IPV4=1
# OKX_CACHE_FRESH_MS=300000
# OKX_PROXY=
# OKX_UPSTREAM=
# OKX_SEED_TOKEN=
PORT=80

# OKX 跟单监控（公开 API，无需 Key）
# OKX_TOP_N=50
# OKX_INST_TYPE=SWAP
# OKX_SORT_TYPE=pnl_ratio
# OKX_POLL=1
# OKX_POLL_INTERVAL_MS=30000
# OKX_REQUEST_GAP_MS=180

# X / Sorsa（只拉 user-tweets，默认 30 分钟；北京时间 9:00–次日 3:00）
# SORSA_API_KEY=
# X_POLL=1
# X_POLL_INTERVAL_MS=1800000
# X_PER_USER_KEEP=15
# X_USER_GAP_MS=1500
