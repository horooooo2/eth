  "deadline": {
    "enabled": true,
    "total_days": 90,
    "start_date": null,
    "pressure_curve": {
      "day_1_to_30": 0.0,
      "day_31_to_60": "linear 0.00 -> 0.02",
      "day_61_to_90": "linear 0.02 -> 0.05"
    },
    "pressure_target": "stress_baseline",
    "note": "三个月期限作为压力因子，缓慢抬升 stress 基线。不直接影响决策，只影响长期心理负担。",
    "evaluation_trigger": {
      "enabled": true,
      "trigger_day": 90,
      "mode": "llm_decides",
      "decision_type": "continue_or_stop",
      "input_fields": [
        "current_state",
        "account_pnl",
        "baseline_drift",
        "consecutive_results",
        "subjective_feeling"
      ],
      "output_schema": {
        "decision": "CONTINUE|STOP|EXTEND",
        "reason": "一句话理由",
        "new_deadline_days": "integer|null"
      }
    }
  },
  "news_behavior": {
    "enabled": true,
    "note": "张明的新闻行为由状态驱动，不是定时器。他会根据自己的心理状态、持仓情况和市场环境，主动决定什么时候搜索、搜索什么。",
    "search_provider": "deepseek_responses",
    "model": "deepseek-v4-flash",
    "daily_windows": {
      "morning": {
        "time_range": [
          "08:00",
          "10:00"
        ],
        "label": "早间浏览",
        "intent": "看昨晚到今早发生了什么，判断今天市场基调",
        "base_probability": 0.7
      },
      "noon": {
        "time_range": [
          "11:30",
          "13:00"
        ],
        "label": "午间速览",
        "intent": "看看有没有重要的宏观数据发布",
        "base_probability": 0.35
      },
      "evening": {
        "time_range": [
          "20:00",
          "22:30"
        ],
        "label": "晚间复盘",
        "intent": "总结今天发生的事，为明天做准备",
        "base_probability": 0.6
      },
      "late_night": {
        "time_range": [
          "23:00",
          "02:00"
        ],
        "label": "深夜浏览",
        "intent": "睡不着或者扛单时，会反复刷",
        "base_probability": 0.2
      }
    },
    "state_modifiers": {
      "has_open_position": {
        "condition": "position_count > 0",
        "multiplier": 1.5,
        "note": "有持仓时更频繁地看新闻"
      },
      "big_floating_loss": {
        "condition": "unrealized_pnl_pct < -0.005",
        "multiplier": 2.0,
        "note": "浮亏时频繁查看，想找原因"
      },
      "recent_loss_streak": {
        "condition": "consecutive_losses >= 3",
        "multiplier": 1.8,
        "note": "连续止损后，想看看是不是有系统性原因"
      },
      "high_stress": {
        "condition": "stress > 0.65",
        "multiplier": 1.4,
        "note": "焦虑时更想看信息"
      },
      "no_trade_recently": {
        "condition": "hours_since_last_trade > 24",
        "multiplier": 1.3,
        "note": "长时间没交易，会主动找机会"
      },
      "near_major_event": {
        "condition": "days_to_major_macro_event <= 1",
        "multiplier": 2.0,
        "note": "临近非农、CPI、FOMC 时会更关注"
      },
      "post_big_win": {
        "condition": "recent_big_win_within_6h",
        "multiplier": 0.7,
        "note": "大赚之后会稍微放松"
      },
      "low_sleep": {
        "condition": "sleep_debt > 4",
        "multiplier": 1.2,
        "note": "睡不好时反而更依赖信息来找确定感"
      }
    },
    "daily_frequency_limit": {
      "max_checks_per_day": 6,
      "min_interval_minutes": 90,
      "note": "每天最多 6 次，两次之间至少 90 分钟"
    },
    "search_queries_by_context": {
      "holding_long_btc": [
        "BTC 今日行情 最新消息",
        "比特币 技术分析 今天",
        "加密货币 市场情绪 今日"
      ],
      "holding_short_btc": [
        "BTC 今日下跌原因",
