    },
    "financial_situation": {
      "savings": "约 50 万存款",
      "debt": "无房贷、无车贷",
      "monthly_expense": "家庭基本开销约 6000-8000",
      "income_source": "存款利息 + 交易收益 + 偶尔接外包",
      "financial_pressure": "低。生活无压力，但希望交易能覆盖家庭开销"
