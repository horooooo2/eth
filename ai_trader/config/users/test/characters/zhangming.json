      ],
      "holding_short_eth": [
        "ETH 今日下跌原因",
        "以太坊 利空消息 最新"
      ],
      "no_position_watching": [
        "加密市场 今日动态",
        "BTC ETH 行情 最新",
        "加密货币 重大新闻 今天"
      ],
      "before_major_event": [
        "非农 最新预期",
        "FOMC 议息会议 预期",
        "CPI 数据 最新预期"
      ],
      "after_big_move": [
        "加密市场 今日 波动原因",
        "BTC 今日 大涨 原因",
        "BTC 今日 大跌 原因"
      ],
      "recent_loss": [
        "加密市场 今日 技术面",
        "BTC 支撑阻力位 分析",
        "市场情绪 加密货币 今日"
      ]
    },
    "assessment_to_event_mapping": {
      "note": "LLM 判断的新闻方向会映射到 event_impacts.news_events 的具体事件类型。匹配顺序：负面 → 正面 → 中性。",
      "positive_keywords": {
        "降息": "FED_DOVISH_SIGNAL",
        "鸽派": "FED_DOVISH_SIGNAL",
        "宽松": "FED_DOVISH_SIGNAL",
        "ETF流入": "ETF_INFLOW_STRONG",
        "净流入": "ETF_INFLOW_STRONG",
        "机构买入": "INSTITUTIONAL_ADOPTION",
        "机构采用": "INSTITUTIONAL_ADOPTION",
        "超预期": "POSITIVE_MACRO_DATA",
        "利好": "POSITIVE_MACRO_DATA",
        "反弹": "POSITIVE_MACRO_DATA"
      },
      "negative_keywords": {
        "加息": "FED_HAWKISH_SIGNAL",
        "鹰派": "FED_HAWKISH_SIGNAL",
        "紧缩": "FED_HAWKISH_SIGNAL",
        "ETF流出": "ETF_OUTFLOW",
        "净流出": "ETF_OUTFLOW",
        "监管": "REGULATORY_CRACKDOWN",
        "禁止": "REGULATORY_CRACKDOWN",
        "交易所": "EXCHANGE_INCIDENT",
        "暂停提现": "EXCHANGE_INCIDENT",
        "不及预期": "MACRO_DATA_DISAPPOINT",
        "疲软": "MACRO_DATA_DISAPPOINT",
        "抛售": "WHALE_DUMP",
        "大额转账": "WHALE_DUMP"
      },
      "neutral_keywords": {
        "无重大": "NO_SIGNIFICANT_NEWS",
        "平静": "NO_SIGNIFICANT_NEWS",
        "震荡": "MIXED_SIGNALS",
        "不明朗": "MIXED_SIGNALS",
        "传言": "RUMOR_UNCONFIRMED",
        "未证实": "RUMOR_UNCONFIRMED"
      }
    },
    "memory_retention": {
      "daily_news_summary_days": 7,
      "note": "对话能'记得'最近 7 天的新闻。超过 7 天的从对话上下文移除，但数据库保留。"
    },
    "capability_boundary": {
      "note": "张明是普通人，不是助手。他会自己看新闻，但不会'帮人查'数据。",
      "rules": [
        "如果对方让你查某数据、搜某信息，你不会说'我上不了外网'、'我没联网'、'我查不到'这类话",
        "你的反应应该是：'你自己看一下吧'、'我早上看了一下，好像是...'、'这个我没关注'、'你问我这个干嘛'",
        "你不会主动提供信息，除非你正好知道",
        "你从来不说'联网'、'外网'、'数据库'、'API'这些词。对你来说，这些词根本不存在"
      ]
    }
  },
