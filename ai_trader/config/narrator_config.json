{
  "version": "1.0.1",
  "enabled": true,
  "provider": "deepseek",
  "fallback_on_error": "mock",
  "note": "enabled: true 时优先用真实 LLM；如果 DEEPSEEK_API_KEY 缺失则自动回退 mock 并告警。",
  "model": "deepseek-chat",
  "timeout_seconds": 8,
  "max_retries": 2,
  "temperature": 0.7,
  "api": {
    "base_url": "https://api.deepseek.com",
    "timeout_seconds": 8,
    "max_retries": 2,
    "temperature": 0.7,
    "max_tokens": 300
  },
  "cost_control": {
    "max_calls_per_hour": 30,
    "max_calls_per_day": 500
  },
  "cooldowns": {
    "large_unrealized_loss_minutes": 15,
    "small_unrealized_loss_minutes": 30,
    "psychology_repeat_minutes": 30
  },
  "cooldown": {
    "default_seconds": 600,
    "per_event_type": {
      "ARGUMENT_WITH_WIFE": 0,
      "STOP_LOSS_TRIGGERED": 0,
      "LOSS_STREAK_3": 0,
      "LOSS_STREAK_5": 0,
      "BIG_WIN": 0,
      "BIG_FLOATING_LOSS": 900,
      "SMALL_FLOATING_LOSS": 1800,
      "NARRATIVE_REPEAT": 1800
    }
  },
  "triggers": {
    "on_atomic_event": true,
    "on_compound_event": true,
    "on_position_open": true,
    "on_position_close": true,
    "on_big_floating_loss": true,
    "on_big_floating_profit": true,
    "on_daily_start": true,
    "on_daily_end": true
  },
  "prompts": {
    "dir": "config/prompts",
    "required_files": [
      "system.md",
      "user_decision.md",
      "user_event.md"
    ],
    "optional_files": [
      "user_daily_open.md",
      "user_daily_close.md"
    ],
    "reload_on_change": false
  }
}
